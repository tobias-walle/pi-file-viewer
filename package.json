{
  "name": "pi-file-viewer",
  "version": "0.1.0",
  "description": "Pi extension for reviewing write and edit tool calls in an interactive file viewer.",
  "type": "module",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "file-viewer",
    "review"
  ],
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "biome check . && bun run typecheck && bun test",
    "test": "bun test",
    "dev": "pi --no-extensions -e ."
  },
  "pi": {
    "extensions": [
      "./extension/index.ts"
    ]
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@mariozechner/pi-coding-agent": "^0.73.1",
    "@mariozechner/pi-tui": "^0.73.1",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.2",
    "typescript": "^6.0.3"
  }
}
