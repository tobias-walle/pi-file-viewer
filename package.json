{
  "name": "pi-file-viewer",
  "version": "0.1.0",
  "description": "Pi extension for reviewing write and edit tool calls in an interactive file viewer.",
  "type": "module",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "file-viewer",
    "review"
  ],
  "license": "MIT",
  "files": [
    "extension",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./extension/index.ts",
    "./extension": "./extension/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "biome check --write . && bun run typecheck && bun test",
    "test": "bun test",
    "coverage": "bun test --coverage",
    "dev": "pi --no-extensions -e ."
  },
  "pi": {
    "extensions": [
      "./extension/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.2",
    "typescript": "^6.0.3",
    "@earendil-works/pi-coding-agent": "^0.79.4",
    "@earendil-works/pi-tui": "^0.79.4"
  }
}
